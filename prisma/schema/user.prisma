model User {
  id        String   @id @default(uuid())
  birthdate DateTime @db.Date
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
